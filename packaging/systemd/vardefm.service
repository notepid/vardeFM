[Unit]
Description=VardeFM modem (open FM data modem, VARA-compatible TCP interface)
Documentation=https://github.com/notepid/vardeFM
After=sound.target network.target
Wants=sound.target

[Service]
Type=simple
# By default, uses the default sound card and VOX.
# To configure sound cards and PTT (e.g. --audio-in, --audio-out, --ptt),
# override ExecStart using: systemctl edit vardefm
ExecStart=/usr/bin/vardefm modem --quiet
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
DynamicUser=yes
SupplementaryGroups=audio
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target

